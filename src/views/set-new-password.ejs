<%- include("partials/auth-header", { title: title }) %>
<section class="auth-new-page">

    <div class="auth-new-left">

        <a href="/" class="auth-new-logo">
            <span>F</span>
            <strong>Khushi</strong>
            <b>Enterprises.</b>
        </a>

        <div class="auth-new-form-box">

            <h1>Set New Password</h1>
            <p>Must be at least 8 characters</p>

            <form id="setNewPasswordForm">

                <div class="auth-field password-field">
                    <label>Password *</label>

                    <div class="password-input">
                        <input 
                            type="password" 
                            id="newPassword"
                            placeholder="Enter Password" 
                            required
                        >

                        <button type="button" onclick="togglePassword('newPassword')">
                            👁
                        </button>
                    </div>
                </div>

                <div class="auth-field password-field">
                    <label>Confirm Password *</label>

                    <div class="password-input">
                        <input 
                            type="password" 
                            id="confirmPassword"
                            placeholder="Enter Password" 
                            required
                        >

                        <button type="button" onclick="togglePassword('confirmPassword')">
                            👁
                        </button>
                    </div>
                </div>

                <button type="submit" class="auth-main-btn">
                    Reset Password
                </button>

            </form>

        </div>

    </div>

    <div class="auth-new-right">

        <img loading="lazy" 
            src="/assets/images/banners/set-new-password-auth.webp" 
            alt="Interior"
         title="Interior">

        <div class="auth-review-card">
            <p>
                “Create a secure password and continue your shopping experience
                with Khushi Enterprises.”
            </p>

            <h3>Khushi Enterprises</h3>
            <span>Online Beanbag Store</span>
        </div>

        <div class="auth-slider-lines">
            <span></span>
            <span></span>
            <span></span>
            <span class="active"></span>
        </div>

    </div>

</section>



<script defer src="/js/pages/set_new_password.js"></script>
<%- include("partials/auth-footer") %>
