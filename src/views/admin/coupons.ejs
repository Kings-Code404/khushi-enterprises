<%- include("../partials/admin-header", { title: "Coupon Management | Khushi Enterprises" }) %>
<section class="admin-dashboard">
  <div class="dashboard-header"><h1>Coupon Management</h1><p>Create and manage discount coupons.</p></div>
  <form id="couponForm" class="admin-form" style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:20px;">
    <input name="code" placeholder="Coupon Code" required>
    <select name="discount_type"><option value="fixed">Fixed</option><option value="percentage">Percentage</option></select>
    <input name="discount_value" type="number" step="0.01" placeholder="Discount Value" required>
    <input name="expiry_date" type="datetime-local">
    <button class="small-btn" type="submit">Create Coupon</button>
  </form>
  <div class="admin-table-box"><table class="admin-table"><thead><tr><th>ID</th><th>Code</th><th>Type</th><th>Value</th><th>Expiry</th><th>Status</th><th>Action</th></tr></thead><tbody id="couponsTable"><tr><td colspan="7">Loading coupons...</td></tr></tbody></table></div>
</section>
<script defer src="/js/pages/admin_coupons.js"></script>
<%- include("../partials/admin-footer") %>
