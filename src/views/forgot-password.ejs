<%- include("partials/auth-header", { title: title }) %>
<section class="auth-new-page">

    <!-- LEFT FORM -->
    <div class="auth-new-left">

        <a href="/" class="auth-new-logo">
            <span>F</span>
            <strong>Khushi</strong>
            <b>Enterprises.</b>
        </a>

        <div class="auth-new-form-box">

            <h1>Forgot Password?</h1>
            <p>Don’t worry, we’ll send you reset instructions.</p>

            <form id="forgotPasswordForm">

                <div class="auth-field">
                    <label>Email *</label>
                    <input 
                        type="email" 
                        name="email" 
                        placeholder="Enter Email Here" 
                        required
                    >
                </div>

                <button type="submit" class="auth-main-btn">
                    Submit
                </button>

                <p class="auth-switch">
                    Remember Password?
                    <a href="/login">Sign In</a>
                </p>

            </form>

        </div>

    </div>

    <!-- RIGHT IMAGE -->
    <div class="auth-new-right">

        <img loading="lazy" 
            src="/assets/images/banners/forgot-password-auth.webp" 
            alt="Interior"
         title="Interior">

        <div class="auth-review-card">
            <p>
                “Reset your password securely and continue shopping your
                favorite beanbag products.”
            </p>

            <h3>Khushi Enterprises</h3>
            <span>Online Beanbag Store</span>
        </div>

        <div class="auth-slider-lines">
            <span></span>
            <span></span>
            <span></span>
            <span class="active"></span>
        </div>

    </div>

</section>



<script defer src="/js/pages/forgot_password.js"></script>
<%- include("partials/auth-footer") %>
