<%- include("partials/header", { title: "FAQs | Khushi Enterprises" }) %>

<!-- FAQ BANNER -->
<section class="shop-banner">
    <h1>FAQs</h1>
    <p>
        <a href="/">Home</a> / FAQs
    </p>
</section>

<!-- FAQ PAGE -->
<section class="faq-page-section">

    <div class="faq-wrapper">

        <!-- LEFT CATEGORIES -->
        <div class="faq-categories">
            <button class="active">General Information</button>
            <button>Ordering & Shipping</button>
            <button>Returns & Exchanges</button>
            <button>Payments & Discounts</button>
            <button>Account & Profile</button>
        </div>

        <!-- RIGHT FAQ ACCORDION -->
        <div class="faq-accordion">

            <div class="faq-item">
                <button class="faq-question">
                    How can I place an order?
                    <span>+</span>
                </button>

                <div class="faq-answer">
                    <p>
                        You can place an order by selecting a beanbag, adding it to your cart,
                        and completing checkout with your billing and delivery details.
                    </p>
                </div>
            </div>

            <div class="faq-item active">
                <button class="faq-question">
                    What payment methods do you accept?
                    <span>−</span>
                </button>

                <div class="faq-answer">
                    <p>
                        We currently support Cash on Delivery, UPI, and card payment options.
                        More payment methods can be added in future updates.
                    </p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Can I track my order after it's been placed?
                    <span>+</span>
                </button>

                <div class="faq-answer">
                    <p>
                        Yes, you can track your order from the Track Your Order page using
                        your Order ID and billing email.
                    </p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Do you offer customer support?
                    <span>+</span>
                </button>

                <div class="faq-answer">
                    <p>
                        Yes, you can contact us using the Contact Us page. Our support team
                        will respond as soon as possible.
                    </p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    What is your return policy?
                    <span>+</span>
                </button>

                <div class="faq-answer">
                    <p>
                        Returns are available according to the store return policy. Products
                        must be unused and returned within the allowed return period.
                    </p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    How to Create Account?
                    <span>+</span>
                </button>

                <div class="faq-answer">
                    <p>
                        Click on the Login button, choose Register, fill in your details,
                        and create your account.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>

<!-- SERVICE STRIP -->
<section class="ke-service-strip shop-service">
    <div>
        <span>📦</span>
        <h4>Free Shipping</h4>
        <p>Free shipping for selected orders</p>
    </div>

    <div>
        <span>💳</span>
        <h4>Flexible Payment</h4>
        <p>COD and UPI payment options</p>
    </div>

    <div>
        <span>🎧</span>
        <h4>24×7 Support</h4>
        <p>We support online all days</p>
    </div>
</section>




<script defer src="/js/pages/faqs.js"></script>
<%- include("partials/footer") %>