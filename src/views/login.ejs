<%- include("partials/auth-header", { title: title }) %>
<section class="auth-new-page">

    <!-- LEFT FORM -->
    <div class="auth-new-left">

        <a href="/" class="auth-new-logo">
            <span>F</span>
            <strong>Khushi</strong>
            <b>Enterprises.</b>
        </a>

        <div class="auth-new-form-box">

            <h1>Sign In</h1>
            <p>Please fill your detail to access your account.</p>

            <form id="loginForm">

                <div class="auth-field">
                    <label>Email *</label>
                    <input 
                        type="email" 
                        name="email" 
                        placeholder="Enter Email Address" 
                        required
                    >
                </div>

                <div class="auth-field password-field">
                    <label>Password *</label>
                    <div class="password-input">
                        <input 
                            type="password" 
                            name="password" 
                            id="loginPassword"
                            placeholder="Enter Password" 
                            required
                        >
                        <button type="button" onclick="toggleLoginPassword()">👁</button>
                    </div>
                </div>

                <div class="auth-options">
                    <label>
                        <input type="checkbox" checked>
                        Remember me
                    </label>

                    <a href="/forgot-password">Forgot Password?</a>
                </div>

                <button type="submit" class="auth-main-btn">
                    Sign In
                </button>

                <div class="auth-divider">
                    <span></span>
                    <p>or Sign In with</p>
                    <span></span>
                </div>

                <button type="button" class="google-btn">
                    <span>G</span>
                    Sign In With Google
                </button>

                <p class="auth-switch">
                    Don’t have an account?
                    <a href="/register">Sign Up</a>
                </p>

            </form>

        </div>

    </div>

    <!-- RIGHT IMAGE -->
    <div class="auth-new-right">

        <img loading="lazy" 
            src="/assets/images/banners/login-auth.webp" 
            alt="Interior"
         title="Interior">

        <div class="auth-review-card">
            <p>
                “Khushi Enterprises provides comfortable and stylish beanbags
                that make every room feel more relaxed and modern.”
            </p>

            <h3>Sumit Kumar</h3>
            <span>Full Stack Developer</span>
        </div>

        <div class="auth-slider-lines">
            <span class="active"></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

    </div>

</section>



<script defer src="/js/pages/login.js"></script>
<%- include("partials/auth-footer") %>
